# Disposable local-only values for Docker Compose; never reuse them in staging/production.
RB_ENV=local
RB_DATABASE_URL=
RB_MIGRATOR_DATABASE_URL=
RB_S3_ENDPOINT_URL=http://minio:9000
RB_S3_REGION=us-east-1
RB_S3_BUCKET=reconbench-local
RB_S3_API_ACCESS_KEY=not-configured
RB_S3_API_SECRET_KEY=not-configured
RB_S3_WORKER_ACCESS_KEY=
RB_S3_WORKER_SECRET_KEY=
# AI Assist: off unless explicitly enabled. Keys are sealed with the public key
# (API) and opened only by the AI worker's private keyring; run `make ai-keys`.
RB_AI_EXTERNAL_CALLS=disabled
RB_AI_EXTERNAL_CALLS_APPROVAL_REF=
RB_AI_SEAL_PUBLIC_KEY_FILE=deploy/secrets/api/ai_seal_public.json
RB_AI_KEYRING_FILE=
RB_AI_LIMITS_FILE=
RB_AI_PRICE_FILE=
RB_PUBLIC_BASE_URL=http://localhost:5173
RB_PDF_OCR_LANGUAGES=eng
# Optional PEM/DER file with the e-invoice portal's QR-signing public key(s).
RB_EINVOICE_PUBLIC_KEY_FILE=
# Vision reader for masked page images (accuracy plan AC-5): vision_gemini or off.
RB_VISION_READER=vision_gemini
RB_BOOTSTRAP_ADMIN_EMAIL=
RB_BOOTSTRAP_ADMIN_PASSWORD=
RB_RECONCILIATION_PROCESSES=1
RB_LOG_LEVEL=INFO
RB_OTEL_EXPORTER_OTLP_ENDPOINT=
RB_SENTRY_DSN=

# Service initialization settings used only by the Phase 1 local Compose stack.
POSTGRES_DB=reconbench
POSTGRES_USER=reconbench
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
MINIO_ROOT_USER=reconbench-local
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=5173

# Optional Phase 4 test database profile. It uses its own persistent named volume.
PHASE4_TEST_POSTGRES_DB=reconbench_phase4
PHASE4_TEST_POSTGRES_USER=reconbench_test
PHASE4_TEST_POSTGRES_PASSWORD=
PHASE4_TEST_POSTGRES_PORT=15433
